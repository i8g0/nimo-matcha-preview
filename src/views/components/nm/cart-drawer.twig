{#
  Mini cart: side panel on desktop, bottom sheet on phones, plus the "added" toast.
  Lines are rendered by cart-ui.js from the Salla cart (salla.cart.details), so it stays in sync on every page.
  "Complete your cup" suggestions come from the theme setting upsell_products.
#}
{% set upsell = theme.settings.get('upsell_products', []) %}
<div class="nm-drawer" data-nm-drawer hidden>
    <div class="nm-drawer__scrim" data-nm-cart-close></div>
    <aside class="nm-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ trans('nm.your_cart') }}">
        <span class="nm-drawer__grip" aria-hidden="true"></span>
        <div class="nm-drawer__head">
            <h2>{{ trans('nm.your_cart') }} <small><span data-nm-cart-count-text>0</span> {{ trans('nm.items') }}</small></h2>
            <button class="nm-icon-btn" type="button" data-nm-cart-close aria-label="{{ trans('nm.close') }}">
                {% include 'components.nm.icon' with {name: 'close', size: 20} %}
            </button>
        </div>
        <div class="nm-drawer__body">
            <div class="nm-free" data-nm-free hidden>
                <p data-nm-free-text></p>
                <span class="nm-free__bar"><span data-nm-free-fill style="width:0"></span></span>
            </div>
            <div data-nm-lines></div>
            <div class="nm-drawer__empty" data-nm-empty>
                <img src="{{ store.logo }}" alt="" width="96" height="96" loading="lazy">
                <strong>{{ trans('nm.empty_cart') }}</strong>
                <span>{{ trans('nm.empty_cart_hint') }}</span>
                <a class="nm-btn" href="{{ store.url }}" data-nm-cart-close>{{ trans('nm.shop_now') }}</a>
            </div>
            {% if upsell|length %}
                <section class="nm-upsell" data-nm-upsell hidden>
                    <h3>{{ theme.settings.get('upsell_title') ?: trans('nm.complete_cup') }}</h3>
                    <div class="nm-upsell__list">
                        {% for u in upsell %}
                            {% set uid = u.id is defined ? u.id : (u.value is defined ? u.value : (u.key is defined ? u.key : u)) %}
                            <div class="nm-up" data-nm-up="{{ uid }}" hidden></div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
        <div class="nm-drawer__foot" data-nm-foot hidden>
            <div class="nm-drawer__total"><span>{{ trans('nm.subtotal') }}</span><strong data-nm-subtotal></strong></div>
            <salla-installment data-nm-installment price="0"></salla-installment>
            <a class="nm-btn nm-btn--block nm-btn--lg" href="{{ link('cart') }}">{{ trans('nm.checkout') }}</a>
        </div>
    </aside>
</div>

<div class="nm-toast" data-nm-toast role="status" aria-live="polite" hidden>
    <img alt="" data-nm-toast-img>
    <span>{{ trans('nm.added') }}</span>
    <button type="button" data-nm-cart-open>{{ trans('nm.view_cart') }}</button>
</div>
