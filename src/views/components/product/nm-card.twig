{#
  The one product card of the store (home sections, listings, related).
  Include with: {% include 'components.product.nm-card' with {product: p, eager: false} %}
  The JS twin (assets/js/nm/card.js) renders the same markup for Salla's product lists.
  - "cups" chip: filled by JS from the weight in the product name (80 جرام → ~40 كوب).
  - badge: the product's promotion title (Salla field), plus the discount percent.
#}
{% import 'components.nm.macros' as nm %}
{% set off = nm.off(product)|trim %}
{% set second = product.images|length > 1 ? product.images[1].url : null %}
<article class="nm-card {{ product.is_available ? '' : 'nm-card--out' }}" data-nm-card data-category="{{ product.category.name }}" data-name="{{ product.name }}" data-price="{{ product.price }}">
    <a class="nm-card__media" href="{{ product.url }}" aria-label="{{ product.name }}">
        <img src="{{ product.image.url }}" alt="{{ product.image.alt ?: product.name }}" {{ eager ? 'fetchpriority="high"' : 'loading="lazy"' }} decoding="async" width="600" height="600" data-nm-fly-src>
        {% if second %}<img src="{{ second }}" alt="" loading="lazy" decoding="async" width="600" height="600">{% endif %}
        <span class="nm-card__badges">
            {% if off %}<span class="nm-chip nm-chip--pink">{{ trans('nm.save') }} {{ off }}٪</span>{% endif %}
            {% if product.promotion_title %}<span class="nm-chip nm-chip--green">{{ product.promotion_title }}</span>{% endif %}
            {% if not product.is_available %}<span class="nm-chip nm-chip--soft">{{ trans('nm.sold_out') }}</span>{% endif %}
        </span>
    </a>
    {% if product.is_available %}
        <button class="nm-card__add" type="button" {{ nm.add_attrs(product) }} aria-label="{{ trans('nm.add_to_cart') }}: {{ product.name }}">
            {% include 'components.nm.icon' with {name: 'plus', size: 20} %}{% include 'components.nm.icon' with {name: 'check', size: 20} %}
        </button>
    {% endif %}
    <div class="nm-card__body">
        {% if product.category %}<span class="nm-card__cat">{{ product.category.name }}</span>{% endif %}
        <a class="nm-card__name" href="{{ product.url }}">{{ product.name }}</a>
        <div class="nm-card__meta">
            <span class="nm-cups" data-nm-cups hidden></span>
            {% if product.rating and product.rating.count %}
                <span class="nm-stars" style="--s: {{ product.rating.stars }}" aria-label="{{ product.rating.stars }}/5">★★★★★</span>
            {% endif %}
        </div>
        <div class="nm-card__price">{{ nm.price(product) }}</div>
    </div>
</article>
