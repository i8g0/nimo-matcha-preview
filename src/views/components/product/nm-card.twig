{#
  The one product card of the store (home sections, listings, related).
  Include with: {% include 'components.product.nm-card' with {product: p, eager: false} %}
  The JS twin (assets/js/nm/card.js) renders the same markup for Salla's product lists.
  - "cups" line: filled by JS from the weight in the product name (80 جرام → ~40 كوب).
  - labels: the product's promotion title (Salla field), plus the discount percent.
#}
{% import 'components.nm.macros' as nm %}
{% set off = nm.off(product)|trim %}
{% set second = product.images|length > 1 ? product.images[1].url : null %}
<article class="nm-card {{ product.is_available ? '' : 'nm-card--out' }}" data-nm-card data-category="{{ product.category.name }}" data-name="{{ product.name }}" data-price="{{ product.price }}">
    <a class="nm-card__stage" href="{{ product.url }}" aria-label="{{ product.name }}">
        <img src="{{ product.image.url }}" alt="{{ product.image.alt ?: product.name }}" {{ eager ? 'fetchpriority="high"' : 'loading="lazy"' }} decoding="async" width="600" height="750" data-nm-fly-src>
        {% if second %}<img src="{{ second }}" alt="" loading="lazy" decoding="async" width="600" height="750">{% endif %}
        <span class="nm-card__badges">
            {% if product.promotion_title %}<span class="nm-label nm-label--solid">{{ product.promotion_title }}</span>{% endif %}
            {% if off %}<span class="nm-label">{{ trans('nm.save') }} {{ off }}%</span>{% endif %}
            {% if not product.is_available %}<span class="nm-label nm-label--muted">{{ trans('nm.sold_out') }}</span>{% endif %}
        </span>
    </a>
    <div class="nm-card__foot">
        <div class="nm-card__body">
            {% if product.category %}<span class="nm-card__cat">{{ product.category.name }}</span>{% endif %}
            <a class="nm-card__name" href="{{ product.url }}">{{ product.name }}</a>
            <span class="nm-card__rule" aria-hidden="true"></span>
            <div class="nm-card__price">{{ nm.price(product) }}</div>
            <span class="nm-cups" data-nm-cups hidden></span>
            {% if product.is_available %}
                <button class="nm-addbtn nm-card__buy" type="button" {{ nm.add_attrs(product) }} aria-label="{{ trans('nm.add_to_cart') }}: {{ product.name }}">
                    <span class="nm-addbtn__a">{% include 'components.nm.icon' with {name: 'cart', size: 16} %}{{ trans('nm.add_to_cart') }}</span>
                    <span class="nm-addbtn__b">{% include 'components.nm.icon' with {name: 'check', size: 16} %}{{ trans('nm.added_short') }}</span>
                </button>
            {% endif %}
        </div>
    </div>
</article>
