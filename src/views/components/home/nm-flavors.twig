{#
| component.eyebrow, title, accent | string |
| component.items[] | name, accent (matcha|mango|vanilla|berry|caramel), line, image, product (Product[]) |
Choosing a flavour cross-fades the full-bleed photo, the line and the product (sections.js).
Works without JS: the first flavour shows.
#}
{% import 'components.nm.macros' as nm %}
{% set items = component.items|default([]) %}
{% if items|length %}
<section class="nm-flavors" id="flavors" data-tone="night" data-nm-flavors component-id="{{ componentId }}">
    <div class="nm-flavors__bg" aria-hidden="true" data-nm-flavor-stage>
        {% for f in items %}
            {% set p = f.product|first %}
            {% set img = f.image ?: (p ? p.image.url : null) %}
            <figure class="{{ loop.first ? 'is-active' : '' }}" data-flavor-img="{{ loop.index0 }}">
                {% if img %}<img src="{{ img }}" alt="" loading="lazy" decoding="async">{% endif %}
            </figure>
        {% endfor %}
        {% if items|length > 1 %}<span class="nm-flavors__hint">{% for f in items %}<i class="{{ loop.first ? 'is-on' : '' }}"></i>{% endfor %}</span>{% endif %}
    </div>
    <div class="nm-container nm-flavors__inner">
        <div class="nm-flavors__copy">
            {% include 'components.nm.head' with {c: component} %}
            <ul class="nm-flavors__list" role="group" aria-label="{{ trans('nm.pick_flavor') }}">
                {% for f in items %}
                    {% set accent = include('components.nm.pick', {v: f.accent})|trim ?: 'matcha' %}
                    <li>
                        <button class="nm-flavor-btn" type="button" data-nm-flavor="{{ loop.index0 }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" style="--sw: var(--fl-{{ accent }})">
                            <b>{{ '%02d'|format(loop.index) }}</b><span>{{ f.name }}</span><i aria-hidden="true"></i>
                        </button>
                    </li>
                {% endfor %}
            </ul>
            {% for f in items %}
                {% set p = f.product|first %}
                <div class="nm-flavors__panel" data-flavor-panel="{{ loop.index0 }}" {{ loop.first ? '' : 'hidden' }}>
                    {% if f.line %}<p class="nm-flavors__line">{{ f.line }}</p>{% endif %}
                    {% if p %}
                        <div class="nm-flavors__product" data-nm-card>
                            <a href="{{ p.url }}"><img src="{{ p.image.url }}" alt="{{ p.name }}" loading="lazy" width="64" height="80" data-nm-fly-src></a>
                            <div>
                                <a href="{{ p.url }}"><strong>{{ p.name }}</strong></a>
                                <span class="nm-card__price">{{ nm.price(p) }}</span>
                            </div>
                            {% if p.is_available %}
                                <button class="nm-btn nm-btn--sm" type="button" {{ nm.add_attrs(p) }}>{{ trans('nm.add') }}</button>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
