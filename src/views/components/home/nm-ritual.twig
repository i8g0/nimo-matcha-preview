{#
| component.eyebrow, title, accent, image, video, button | string |
| component.steps[] | measure, title, text |
| component.url | link |
#}
{% import 'components.nm.macros' as nm %}
<section class="nm-section nm-deco nm-deco--0" id="ritual" data-tone="paper" component-id="{{ componentId }}">
    <div class="nm-container">
        {% include 'components.nm.head' with {c: component, modifier: 'center'} %}
        {% if component.video or component.image %}
            <div class="nm-ritual__media" data-reveal>
                {% if component.video %}
                    <video muted playsinline loop preload="none" poster="{{ component.image }}" data-nm-video data-src="{{ component.video }}" aria-label="{{ component.title }}"></video>
                {% else %}
                    <img src="{{ component.image }}" alt="{{ component.title }} {{ component.accent }}" loading="lazy" decoding="async">
                {% endif %}
            </div>
        {% endif %}
        <ol class="nm-steps">
            {% for s in component.steps %}
                <li class="nm-step" data-reveal style="--i: {{ loop.index0 }}">
                    <span class="nm-step__n">STEP {{ '%02d'|format(loop.index) }}</span>
                    <span class="nm-step__measure">{{ s.measure }}</span>
                    <h3>{{ s.title }}</h3>
                    <p>{{ s.text }}</p>
                </li>
            {% endfor %}
        </ol>
        {% if component.button %}<div class="nm-ritual__cta"><a class="nm-btn nm-btn--line" href="{{ nm.href(component.url) }}">{{ component.button }}{% include 'components.nm.icon' with {name: 'arrow', size: 18} %}</a></div>{% endif %}
    </div>
</section>
