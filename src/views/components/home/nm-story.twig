{# | component.image, eyebrow, title, accent, text, button | string | component.facts[] value, label | component.url link | #}
{% import 'components.nm.macros' as nm %}
<section class="nm-section nm-toned {{ component.hide_mobile ? 'nm-hide-mobile' : '' }}" data-tone="night" id="about" component-id="{{ componentId }}">
    <div class="nm-container nm-story__grid">
        <div class="nm-story__media" data-reveal>
            <div class="nm-story__img">
                {% if component.image %}<img src="{{ component.image }}" alt="{{ component.title }} {{ component.accent }}" loading="lazy" decoding="async">{% endif %}
            </div>
            {% include 'components.nm.stamp' with {id: componentId} %}
        </div>
        <div class="nm-story__body">
            {% include 'components.nm.head' with {c: component} %}
            {% if component.text %}<p class="nm-story__text" data-reveal>{{ component.text|nl2br }}</p>{% endif %}
            {% if component.facts|length %}
                <div class="nm-facts">
                    {% for f in component.facts %}<div class="nm-fact" data-reveal style="--i: {{ loop.index0 }}"><b>{{ f.value }}</b><span>{{ f.label }}</span></div>{% endfor %}
                </div>
            {% endif %}
            {% if component.button %}<div><a class="nm-btn nm-btn--glass" href="{{ nm.href(component.url) }}">{{ component.button }}{% include 'components.nm.icon' with {name: 'arrow', size: 18} %}</a></div>{% endif %}
        </div>
    </div>
</section>
