{# | component.items[] | icon, title, text | — trust strip #}
{% if component.items|length %}
<section class="nm-usp" component-id="{{ componentId }}" aria-label="{{ trans('nm.why_nimo') }}">
    <div class="nm-container">
        <ul class="nm-usp__list" style="--n: {{ component.items|length }}">
            {% for item in component.items %}
                {% set icon = include('components.nm.pick', {v: item.icon})|trim ?: 'leaf' %}
                <li class="nm-usp__item" data-reveal style="--i: {{ loop.index0 }}">
                    <span class="nm-usp__icon">{% include 'components.nm.icon' with {name: icon, size: 22} %}</span>
                    <span><strong>{{ item.title }}</strong><span>{{ item.text }}</span></span>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}
