{# | component.items[] | icon, title, text | — quiet trust chips (the text shows as a tooltip) #}
{% if component.items|length %}
<section class="nm-trust-row" component-id="{{ componentId }}" aria-label="{{ trans('nm.why_nimo') }}">
    <div class="nm-container">
        <ul>
            {% for item in component.items %}
                {% set icon = include('components.nm.pick', {v: item.icon})|trim ?: 'leaf' %}
                <li data-reveal style="--i: {{ loop.index0 }}" {% if item.text %}title="{{ item.text }}"{% endif %}>
                    {% include 'components.nm.icon' with {name: icon, size: 18} %}{{ item.title }}
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}
