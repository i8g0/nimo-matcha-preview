{#
| component.slides[]   | tone, image, video, eyebrow, title, accent, text, button, url, button_2, url_2, sticker |
| component.autoplay   | bool |
| component.rating_text| string (empty hides the rating chip) |
Slides cross-fade; the section's colour follows the active slide's tone (sections.js).
#}
{% import 'components.nm.macros' as nm %}
{% set slides = component.slides|default([]) %}
{% if slides|length %}
{% set first_tone = include('components.nm.pick', {v: (slides|first).tone})|trim ?: 'green' %}
<section class="nm-hero" data-tone="{{ first_tone }}" data-nm-hero data-autoplay="{{ component.autoplay ? 'true' : 'false' }}" component-id="{{ componentId }}" aria-roledescription="carousel">
    <div class="nm-hero__deco" aria-hidden="true">
        <svg class="d1" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="3"><path d="M30 170C40 90 90 40 170 30c-10 80-60 130-140 140z"/><path d="M30 170C70 120 110 85 150 55"/><path d="M70 125l-6-30M95 100l-4-32M120 78l-3-28M80 116l34 6M104 92l32 4"/></svg>
        <svg class="d2" viewBox="0 0 200 200" fill="currentColor"><circle cx="30" cy="30" r="10"/><circle cx="90" cy="60" r="6"/><circle cx="150" cy="24" r="14"/><circle cx="120" cy="130" r="8"/><circle cx="40" cy="150" r="5"/></svg>
    </div>
    <div class="nm-container nm-hero__slides">
        {% for slide in slides %}
            {% set tone = include('components.nm.pick', {v: slide.tone})|trim ?: 'green' %}
            <div class="nm-hero__slide {{ loop.first ? 'is-active' : '' }}" data-nm-slide data-tone-name="{{ tone }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ slides|length }}" {{ loop.first ? '' : 'aria-hidden="true"' }}>
                <div class="nm-hero__text">
                    {% if slide.eyebrow %}<span class="nm-eyebrow">{{ slide.eyebrow }}</span>{% endif %}
                    {% if loop.first %}
                        <h1 class="nm-hero__title">{{ slide.title }}{% if slide.accent %} <span class="nm-accent">{{ slide.accent }}</span>{% endif %}</h1>
                    {% else %}
                        <h2 class="nm-hero__title">{{ slide.title }}{% if slide.accent %} <span class="nm-accent">{{ slide.accent }}</span>{% endif %}</h2>
                    {% endif %}
                    {% if slide.text %}<p class="nm-hero__lead">{{ slide.text }}</p>{% endif %}
                    <div class="nm-hero__ctas">
                        {% if slide.button %}<a class="nm-btn nm-btn--lg" href="{{ nm.href(slide.url) }}" {{ loop.first ? '' : 'tabindex="-1"' }}>{{ slide.button }}{% include 'components.nm.icon' with {name: 'arrow', size: 18} %}</a>{% endif %}
                        {% if slide.button_2 %}<a class="nm-btn nm-btn--ghost nm-btn--lg" href="{{ nm.href(slide.url_2) }}" {{ loop.first ? '' : 'tabindex="-1"' }}>{{ slide.button_2 }}</a>{% endif %}
                    </div>
                    {% if component.rating_text %}
                        <div class="nm-hero__proof"><span class="nm-stars" style="--s:5" aria-hidden="true">★★★★★</span><span>{{ component.rating_text }}</span></div>
                    {% endif %}
                </div>
                <div class="nm-hero__media">
                    <span class="nm-hero__ring" aria-hidden="true"></span>
                    <div class="nm-hero__blob">
                        {% if slide.video %}
                            <video muted playsinline loop preload="none" poster="{{ slide.image }}" data-nm-video data-src="{{ slide.video }}" aria-hidden="true"></video>
                        {% elseif slide.image %}
                            <img src="{{ slide.image }}" alt="{{ slide.title }} {{ slide.accent }}" {{ loop.first ? 'fetchpriority="high"' : 'loading="lazy"' }} decoding="async" width="900" height="940">
                        {% endif %}
                    </div>
                    {% if slide.sticker %}<span class="nm-hero__sticker" aria-hidden="true">{{ slide.sticker }}</span>{% endif %}
                    <span class="nm-hero__mascot" aria-hidden="true"><img src="{{ store.logo }}" alt="" width="64" height="64" loading="lazy"></span>
                </div>
            </div>
        {% endfor %}
    </div>
    {% if slides|length > 1 %}
        <div class="nm-container nm-hero__nav" role="tablist" aria-label="{{ trans('nm.slides') }}">
            {% for slide in slides %}
                <button class="nm-hero__dot {{ loop.first ? 'is-active' : '' }}" type="button" role="tab" data-nm-dot="{{ loop.index0 }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-label="{{ trans('nm.slide') }} {{ loop.index }}"><span></span></button>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endif %}
