{#
  Main banner slider: the merchant's designed banners at full width, never cropped
  (desktop 1900×700, phone 700×1000). Title and button are optional, for banners without text.
| component.slides[] | image, image_mobile, video, title, button, url |
| component.autoplay | bool | component.delay | seconds |
#}
{% import 'components.nm.macros' as nm %}
{% set slides = [] %}
{% for s in component.slides|default([]) %}{% if s.image or s.image_mobile or s.video %}{% set slides = slides|merge([s]) %}{% endif %}{% endfor %}
{% if slides|length %}
<section class="nm-slider" data-nm-slider data-autoplay="{{ component.autoplay is same as(false) ? 'false' : 'true' }}" data-delay="{{ component.delay ?: 5 }}" component-id="{{ componentId }}" aria-roledescription="carousel" aria-label="{{ store.name }}">
    <div class="nm-slider__track">
        {% for s in slides %}
            {% set href = nm.href(s.url)|trim %}
            <div class="nm-slider__slide {{ loop.first ? 'is-active' : '' }}" data-nm-slide role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ slides|length }}" {{ loop.first ? '' : 'aria-hidden="true"' }}>
                {% if href != '#' %}<a class="nm-slider__link" href="{{ href }}" {{ loop.first ? '' : 'tabindex="-1"' }} aria-label="{{ s.title ?: s.button ?: store.name }}"></a>{% endif %}
                {% if s.video %}
                    <video class="nm-slider__media" muted playsinline loop preload="none" poster="{{ s.image }}" data-nm-video data-src="{{ s.video }}" aria-hidden="true"></video>
                {% else %}
                    <picture>
                        {% if s.image_mobile %}<source media="(max-width: 767px)" srcset="{{ s.image_mobile }}">{% endif %}
                        <img class="nm-slider__media" src="{{ s.image ?: s.image_mobile }}" alt="{{ s.title ?: store.name }}" {{ loop.first ? 'fetchpriority="high"' : 'loading="lazy"' }} decoding="async" width="1900" height="700">
                    </picture>
                {% endif %}
                {% if s.title or s.button %}
                    <div class="nm-slider__copy">
                        {% if s.title %}{% if loop.first %}<h1 class="nm-slider__title">{{ s.title }}</h1>{% else %}<h2 class="nm-slider__title">{{ s.title }}</h2>{% endif %}{% endif %}
                        {% if s.button %}<span class="nm-btn nm-btn--lg">{{ s.button }}{% include 'components.nm.icon' with {name: 'arrow', size: 18} %}</span>{% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    {% if slides|length > 1 %}
        <div class="nm-slider__nav">
            <button class="nm-arrow nm-slider__arrow" type="button" data-nm-slide-prev aria-label="{{ trans('nm.previous') }}">{% include 'components.nm.icon' with {name: 'prev', size: 20} %}</button>
            <div class="nm-slider__dots" role="tablist" aria-label="{{ trans('nm.slides') }}">
                {% for s in slides %}
                    <button class="nm-slider__dot {{ loop.first ? 'is-active' : '' }}" type="button" role="tab" data-nm-dot="{{ loop.index0 }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-label="{{ trans('nm.slide') }} {{ loop.index }}"><span></span></button>
                {% endfor %}
            </div>
            <button class="nm-arrow nm-slider__arrow" type="button" data-nm-slide-next aria-label="{{ trans('nm.next') }}">{% include 'components.nm.icon' with {name: 'next', size: 20} %}</button>
        </div>
    {% endif %}
</section>
{% endif %}
